title: $:/plugins/collaborative-blog/settings/seo
tags: $:/tags/cb/SettingsTab
caption: Sharing & SEO

\whitespace trim
\parsermode inline
<p>These settings are written into the page header when you save, so search engines and social media sites can read them.</p>
<$transclude $variable="cb-setting-text" tiddler="$:/config/collaborative-blog/site-description" label="Site description" hint="One or two sentences used by search engines and link previews. Defaults to the tagline."/>
<$transclude $variable="cb-setting-text" tiddler="$:/config/collaborative-blog/og-image" label="Preview image URL" type="url" placeholder="https://example.org/preview.jpg" hint="Shown when the site is shared on social media. 1200 by 630 pixels works well."/>
<$transclude $variable="cb-setting-text" tiddler="$:/config/collaborative-blog/twitter-handle" label="X / Twitter handle" placeholder="@example"/>
<$transclude $variable="cb-setting-text" tiddler="$:/config/collaborative-blog/robots" label="Search engine instructions" placeholder="index, follow" hint="Use noindex, nofollow to ask search engines not to list the site."/>
<$transclude $variable="cb-setting-check" tiddler="$:/config/collaborative-blog/rss-enabled" label="Advertise the RSS feed and sitemap" default="yes" hint="The feed (/rss.xml) and sitemap (/sitemap.xml) are generated by the Cloudflare functions in the starter kit."/>
<h3>Preview of the generated header</h3>
<pre class="cb-setting-preview"><$text text={{{ [cb-head-markup[]] }}}/></pre>
