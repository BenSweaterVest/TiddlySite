{
  "name": "tiddlysite",
  "version": "3.0.0",
  "description": "TiddlyWiki blog plugin and Cloudflare Pages starter kit for small organizations",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:quick": "node scripts/build.mjs --skip-zip",
    "test": "npm run test:functions && npm run build:quick && npm run test:e2e",
    "test:functions": "node --test tests/functions/",
    "test:e2e": "node --test --test-concurrency=1 tests/e2e/",
    "lint": "eslint plugins site scripts tests",
    "lint:fix": "eslint --fix plugins site scripts tests",
    "serve": "node scripts/serve.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BenSweaterVest/TiddlySite.git"
  },
  "keywords": [
    "tiddlywiki",
    "blog",
    "cloudflare-pages",
    "github",
    "cms",
    "static-site",
    "nonprofit"
  ],
  "author": "BenSweaterVest",
  "license": "BSD-3-Clause",
  "bugs": {
    "url": "https://github.com/BenSweaterVest/TiddlySite/issues"
  },
  "homepage": "https://github.com/BenSweaterVest/TiddlySite#readme",
  "devDependencies": {
    "eslint": "^8.57.0",
    "playwright": "^1.64.1",
    "tiddlywiki": "^5.3.8"
  },
  "engines": {
    "node": ">=20"
  },
  "type": "module"
}
